# Copy to .env for local development. Never commit the real file.

# development | testing | staging | production
APP_ENV=development

# Required in staging and production: at least 32 random bytes. The app refuses to start without it.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# PostgreSQL only.
DATABASE_URL=postgresql://selltrack:selltrack@localhost:5432/selltrack_dev

# Used for rate limits. Without it each worker counts on its own, in memory.
REDIS_URL=redis://localhost:6379/0

# Must stay false outside development; staging and production refuse to start otherwise.
DEBUG=false

# How many reverse proxies are in front of Gunicorn (Nginx = 1, Nginx behind a tunnel = 2).
# Client IPs, rate limits and sign-in history are only right when this matches the deployment.
TRUSTED_PROXY_COUNT=0

LOG_LEVEL=INFO

# Optional error reporting.
SENTRY_DSN=
