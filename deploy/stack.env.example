# One stack's settings. Copy to /opt/selltrack/<stack>/.env, fill it in, and keep it private:
#   chmod 600 .env
# Passwords and keys here go into connection strings, so use letters and numbers only:
#   openssl rand -hex 32

# -- Which images run ----------------------------------------------------------------------------
IMAGE_REPO=ghcr.io/wrouigb/selltrack
# staging follows every merge to main. prod only moves when you promote a release.
IMAGE_CHANNEL=prod

# -- The app -------------------------------------------------------------------------------------
# staging or production. Both refuse to start with a weak secret key.
APP_ENV=production
SECRET_KEY=

# How many proxies are in front of the app, counting this stack's Nginx. With a Cloudflare Tunnel or
# Tailscale Funnel in front of Nginx that's 2. Client IPs, rate limits and sign-in history depend on
# this being right, and a wrong number can let people fake their address.
TRUSTED_PROXY_COUNT=2

# Fine for a few hundred people on a Raspberry Pi. On a machine with little memory, try one worker.
WEB_WORKERS=2
WEB_THREADS=4

LOG_LEVEL=INFO
# Optional error reporting.
SENTRY_DSN=

# -- The database --------------------------------------------------------------------------------
# The superuser, used only to set up the three roles below.
POSTGRES_PASSWORD=
# Runs migrations.
DB_MIGRATOR_PASSWORD=
# What the app connects as.
DB_APP_PASSWORD=
# What backups connect as.
DB_BACKUP_PASSWORD=

# -- Where it listens ----------------------------------------------------------------------------
# Only on this machine: a tunnel connects to it here. Give each stack on a machine its own port.
HTTP_PORT=8080

# -- Backups -------------------------------------------------------------------------------------
# An absolute path. If this is empty, it's the backups folder next to this file.
BACKUP_PATH=
# The user on this machine who owns that folder, which backups are written as.
BACKUP_UID=1000
BACKUP_KEEP=14
# 16:00 UTC is about 3am in Melbourne. The nightly cleanup follows at 17:00.
BACKUP_HOUR_UTC=16

# -- The check after each deploy -----------------------------------------------------------------
# An account just for this, which is created if it's missing. It logs in, then adds and deletes a
# sale. If these are empty, that part is skipped, and the deploy checks less.
SMOKE_USERNAME=smoke-check
SMOKE_PASSWORD=
